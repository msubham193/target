# Copy to .env and fill in. .env is git-ignored; never commit real values.
GEOPOC_DB_USER=geopoc
GEOPOC_DB_PASSWORD=
GEOPOC_DB_NAME=geopoc
GEOPOC_DB_HOST=127.0.0.1
GEOPOC_DB_PORT=5433
GEOPOC_DATA_ROOT=D:/geopoc-data
# Development services bind to loopback only. Do not change to 0.0.0.0.
GEOPOC_API_HOST=127.0.0.1
GEOPOC_API_PORT=8000
# Online integrations are off by default (local-first).
GEOPOC_ONLINE_ENABLED=false
