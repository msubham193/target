# Copy to .env and fill in. .env is git-ignored; never commit real values.
GEOPOC_DB_USER=geopoc
GEOPOC_DB_PASSWORD=
GEOPOC_DB_NAME=geopoc
GEOPOC_DB_HOST=127.0.0.1
GEOPOC_DB_PORT=5433
# Uploaded originals are stored here, unmodified. Keep it on a drive with space.
GEOPOC_DATA_ROOT=D:/geopoc-data
# Optional ingestion limits in bytes (defaults: 50 MB photos, 1 GB rasters, 1 GB video). See docs/ingestion.md.
# GEOPOC_MAX_GROUND_IMAGE_BYTES=52428800
# GEOPOC_MAX_RASTER_BYTES=1073741824
# GEOPOC_MAX_VIDEO_BYTES=1073741824
# Development services bind to loopback only. Do not change to 0.0.0.0.
GEOPOC_API_HOST=127.0.0.1
GEOPOC_API_PORT=8000
# Online integrations are off by default (local-first).
GEOPOC_ONLINE_ENABLED=false
# Model weights are installed under GEOPOC_DATA_ROOT/weights by `python -m geopoc.devtools fetch-model`.
# Online integrations stay off; no model is ever contacted remotely.
# Google Earth Engine, GEE-1 controlled evaluation (docs/earth-engine-setup-and-evaluation.md). Off by default. Using it needs
# the account owner's approval, ONE designated Cloud project registered for commercial use, an organisation-owned identity,
# the earthengine-api package (`uv sync --inexact --group earthengine`) and BOTH switches (GEOPOC_ONLINE_ENABLED above and
# GEOPOC_EARTH_ENGINE_ENABLED below), because it contacts a Google service. Never put a key or token in this file.
# GEOPOC_EARTH_ENGINE_ENABLED=false
# GEOPOC_EARTH_ENGINE_PROJECT=
# adc (attached identity), wif (workload identity federation), impersonation, or key_file (last resort).
# GEOPOC_EARTH_ENGINE_AUTH_MODE=adc
# Only with a written administrator exception, and only with auth mode key_file. Name a file OUTSIDE the repository.
# GEOPOC_EARTH_ENGINE_ALLOW_KEY_FILE=false
# GEOPOC_EARTH_ENGINE_CREDENTIALS_FILE=
# A folder OUTSIDE the repository for the kill switch, the single-instance lock and the usage log
# (create it with `python -m geopoc.earth_engine init`), and the display names of the profiles allowed to use Earth Engine.
# GEOPOC_EARTH_ENGINE_CONTROL_DIR=
# GEOPOC_EARTH_ENGINE_DEVELOPERS=
# Fixed low ceilings. They can be lowered here, never raised past the bounds in geopoc/earth_engine/usage.py.
# GEOPOC_EARTH_ENGINE_MAX_REQUESTS_PER_DAY=40
# GEOPOC_EARTH_ENGINE_MAX_REQUESTS_PER_OPERATION=3
# GEOPOC_EARTH_ENGINE_MAX_CONCURRENT=1

# Satellite catalogue discovery, Phase 1 (docs/imagery-discovery.md). Off by default. A search sends a coarse bounding
# box of the area of interest to a third-party catalogue (Copernicus Data Space Ecosystem STAC). It needs ALL of:
# GEOPOC_ONLINE_ENABLED=true (above), the switch below, the account owner's confirmation that the provider's terms were
# read, a project whose source preference is "allow online", and a confirmation on each request. Nothing is downloaded.
# GEOPOC_IMAGERY_ENABLED=false
# GEOPOC_IMAGERY_TERMS_CONFIRMED=false
# GEOPOC_IMAGERY_CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
# The box sent is rounded outward to this many degrees; the exact area stays local.
# GEOPOC_IMAGERY_AOI_ROUND_DEG=0.01
# GEOPOC_IMAGERY_TIMEOUT_S=20
# Optional bearer token obtained by the account owner outside this application. Search is believed to need none.
# Never commit a value; this file must stay free of secrets.
# GEOPOC_IMAGERY_CDSE_ACCESS_TOKEN=

# CDSE S3 authentication check (docs/cdse-s3-integration.md). Off by default. Verifying sends ONE signed, read-only listing
# request (at most one key) to the endpoint below; it sends no project or area data and downloads nothing. It also needs
# GEOPOC_ONLINE_ENABLED=true (above). Generate the keys at https://eodata-s3keysmanager.dataspace.copernicus.eu/ and put
# them ONLY in your local, git-ignored .env, never in this file. Never reuse keys that were ever pasted anywhere.
CDSE_S3_ENABLED=false
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
CDSE_S3_REGION=default
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
# CDSE_S3_TIMEOUT_S=10

# Derived spectral indices (NDVI Studio, docs/ndvi-processing.md). The one server-side folder searched for Sentinel-2 L2A
# band files and their MTD_MSIL2A.xml product metadata. Read-only; a client never supplies a path. Leave unset to offer
# no inputs. Example (use your own folder; for the proof of concept this is a temporary scratch folder, not storage):
# GEOPOC_IMAGERY_BAND_ROOT=C:/path/to/sentinel2-bands
