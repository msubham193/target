# secrets and local configuration
# Earth Engine / Google Cloud credentials must live outside the repository; these patterns are a safety net
*service-account*.json
*-credentials.json
earthengine-credentials*
client_secret*.json
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.hypothesis/

# Node
node_modules/
dist/
*.tsbuildinfo
apps/web/test-results/
apps/web/playwright-report/

# data, weights and caches never belong in the repository
data/
*.pt
*.pth
*.onnx
*.safetensors
*.gguf
*.log

# editors / OS
.vscode/
.idea/
Thumbs.db

# generated walkthrough output: screenshots, browser logs and exports (the written review report stays tracked)
docs/ui-review/screenshots*/
docs/ui-review/*.json
docs/ui-review/*.csv
docs/ui-review/*.geojson
